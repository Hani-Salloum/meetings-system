{
  "name": "fastify-template",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start:production": "node dist/server.js",
    "fix_db": "npx ts-node prisma/fix_db.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:force": "npx prisma db push --force-reset && npx prisma db seed",
    "db:deploy": "npx prisma db push --force-reset && npx prisma db seed"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts",
    "schema": "./prisma/schema"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@fastify/autoload": "^6.1.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@fastify/view": "^11.0.0",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.5.0",
    "@types/bcrypt": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/geoip-lite": "^1.4.4",
    "@types/node-schedule": "^2.1.7",
    "@types/nodemailer": "^6.4.17",
    "accept-language": "^3.0.20",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "fastify": "^5.2.1",
    "fastify-healthcheck": "^5.1.0",
    "fastify-i18next": "^0.5.1",
    "fastify-type-provider-zod": "^4.0.2",
    "firebase-admin": "^13.3.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.0.0",
    "i18next": "^24.2.2",
    "i18next-http-middleware": "^3.7.1",
    "ioredis": "^5.6.0",
    "ioredis-mock": "^8.9.0",
    "jsonwebtoken": "^9.0.2",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.10.0",
    "socket.io": "^4.8.1",
    "ts-node-dev": "^2.0.0",
    "type-fest": "^4.41.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/i18next": "^12.1.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.8",
    "eslint": "^9.30.1",
    "fastify-plugin": "^5.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma": "^6.11.1",
    "tsc-alias": "^1.8.11",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
